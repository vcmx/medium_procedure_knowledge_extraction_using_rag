{
  "part_number": "[A-Z0-9]{2,}-[A-Z0-9]{2,}(?:-[A-Z0-9]+)*",
  "measurement": "\\d+\\.?\\d*\\s*(mm|cm|m|km|in|ft|psi|bar|kPa|MPa|°C|°F|K|lb|kg|g|N|Nm|ft-lb|lb-ft|oz|L|mL|gal|qt|pt)",
  "reference": "(?:figure|table|section|step|page|chapter|appendix|diagram|illustration)\\s+\\d+(?:\\.\\d+)*(?:\\s*[A-Z])?",
  "specification": "\\d+\\.?\\d*\\s*(?:±|to|-|~)\\s*\\d+\\.?\\d*\\s*(?:mm|cm|psi|bar|°C|°F|V|A|Ω|Hz)",
  "model_year": "(?:19|20)\\d{2}\\s*(?:model|year|MY)?",
  "vin_pattern": "[A-HJ-NPR-Z0-9]{17}",
  "engine_code": "[A-Z]{1,4}[0-9]{1,4}[A-Z]?",
  "dtc_code": "[PCBU][0-9]{4}",
  "tool_spec": "(?:T-|SST-)?\\d{5}[A-Z]?",
  "torque_spec": "\\d+(?:\\.\\d+)?\\s*(?:Nm|N·m|ft-lb|lb-ft|in-lb)(?:\\s*\\([^)]+\\))?",
  "angle_spec": "\\d+(?:\\.\\d+)?\\s*(?:°|deg|degrees)",
  "ratio_spec": "\\d+(?:\\.\\d+)?\\s*:\\s*\\d+(?:\\.\\d+)?",
  "percentage": "\\d+(?:\\.\\d+)?\\s*%",
  "rpm_spec": "\\d+(?:,\\d{3})*\\s*(?:rpm|RPM|r/min)",
  "pressure_spec": "\\d+(?:\\.\\d+)?\\s*(?:psi|bar|kPa|MPa|inHg|mmHg)",
  "temperature_range": "\\d+(?:\\.\\d+)?\\s*(?:°C|°F|K)\\s*(?:to|-|~)\\s*\\d+(?:\\.\\d+)?\\s*(?:°C|°F|K)",
  "voltage_spec": "\\d+(?:\\.\\d+)?\\s*(?:V|volts|mV|kV)",
  "current_spec": "\\d+(?:\\.\\d+)?\\s*(?:A|amps|mA|μA)",
  "resistance_spec": "\\d+(?:\\.\\d+)?\\s*(?:Ω|ohms|kΩ|MΩ)",
  "capacity_spec": "\\d+(?:\\.\\d+)?\\s*(?:L|liters|ml|cc|gal|qt|pt|oz)",
  "time_duration": "\\d+(?:\\.\\d+)?\\s*(?:s|sec|seconds|min|minutes|h|hr|hours|ms|milliseconds)",
  "thread_spec": "M\\d+\\s*x\\s*\\d+(?:\\.\\d+)?",
  "wire_gauge": "\\d+\\s*(?:AWG|gauge)",
  "oil_grade": "\\d+W-?\\d+|SAE\\s*\\d+W?",
  "fluid_type": "(?:DOT|ATF|DEX|MERCON|GL)-?\\d+",
  "emission_standard": "(?:Euro|EURO)\\s*\\d+|(?:EPA|CARB)\\s*Tier\\s*\\d+",
  "safety_standard": "(?:FMVSS|ECE|ISO|SAE|DIN)\\s*\\d+(?:\\.\\d+)*"
}